{
  "name": "RiderRating",
  "type": "object",
  "properties": {
    "rider_id": {
      "type": "string",
      "description": "Reference to the rider"
    },
    "rider_name": {
      "type": "string",
      "description": "Rider name for display"
    },
    "customer_email": {
      "type": "string",
      "description": "Customer email"
    },
    "customer_name": {
      "type": "string",
      "description": "Customer name"
    },
    "order_id": {
      "type": "string",
      "description": "Reference to the order"
    },
    "rating": {
      "type": "number",
      "minimum": 1,
      "maximum": 5,
      "description": "Rating from 1 to 5 stars"
    },
    "comment": {
      "type": "string",
      "description": "Optional feedback comment"
    }
  },
  "required": [
    "rider_id",
    "customer_email",
    "order_id",
    "rating"
  ]
}