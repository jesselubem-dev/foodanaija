{
  "name": "Notification",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Customer email"
    },
    "title": {
      "type": "string",
      "description": "Notification title"
    },
    "message": {
      "type": "string",
      "description": "Notification message"
    },
    "type": {
      "type": "string",
      "enum": [
        "order_accepted",
        "order_declined",
        "order_delivered"
      ],
      "description": "Notification type"
    },
    "order_id": {
      "type": "string",
      "description": "Related order ID"
    },
    "is_read": {
      "type": "boolean",
      "default": false,
      "description": "Whether notification has been read"
    },
    "metadata": {
      "type": "object",
      "description": "Additional notification data like image URLs",
      "properties": {
        "image_url": {
          "type": "string",
          "description": "Image to display in notification"
        }
      }
    }
  },
  "required": [
    "user_email",
    "title",
    "message",
    "type"
  ]
}