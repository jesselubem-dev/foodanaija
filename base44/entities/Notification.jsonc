{
  "name": "Notification",
  "properties": {
    "is_read": {
      "default": false,
      "description": "Whether notification has been read",
      "type": "boolean"
    },
    "link": {
      "description": "In-app page to open when tapped, e.g. OrderHistory or RestaurantDetail?id=...",
      "type": "string"
    },
    "message": {
      "description": "Notification message",
      "type": "string"
    },
    "metadata": {
      "description": "Additional notification data like image URLs",
      "properties": {
        "image_url": {
          "description": "Image to display in notification",
          "type": "string"
        }
      },
      "type": "object"
    },
    "order_id": {
      "description": "Related order ID",
      "type": "string"
    },
    "restaurant_id": {
      "description": "Related restaurant ID",
      "type": "string"
    },
    "title": {
      "description": "Notification title",
      "type": "string"
    },
    "type": {
      "description": "Notification type",
      "enum": [
        "order_placed",
        "order_accepted",
        "order_declined",
        "rider_assigned",
        "order_picked_up",
        "order_on_the_way",
        "order_delivered",
        "order_cancelled",
        "restaurant_open",
        "restaurant_closed",
        "promo"
      ],
      "type": "string"
    },
    "user_email": {
      "description": "Customer email",
      "type": "string"
    }
  },
  "required": [
    "user_email",
    "title",
    "message",
    "type"
  ],
  "type": "object"
}