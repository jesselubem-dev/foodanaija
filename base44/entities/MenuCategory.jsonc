{
  "name": "MenuCategory",
  "type": "object",
  "properties": {
    "restaurant_id": {
      "type": "string",
      "description": "Reference to the restaurant"
    },
    "name": {
      "type": "string",
      "description": "Category name (e.g., Rice Dishes, Swallow, Drinks)"
    },
    "description": {
      "type": "string",
      "description": "Category description"
    },
    "display_order": {
      "type": "number",
      "default": 0,
      "description": "Order in which to display"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "restaurant_id",
    "name"
  ]
}