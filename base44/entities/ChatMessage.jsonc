{
  "name": "ChatMessage",
  "type": "object",
  "properties": {
    "chat_id": {
      "type": "string",
      "description": "ID linking messages to a chat session"
    },
    "customer_email": {
      "type": "string",
      "description": "Customer email"
    },
    "customer_name": {
      "type": "string",
      "description": "Customer name"
    },
    "sender_type": {
      "type": "string",
      "enum": [
        "customer",
        "admin",
        "ai"
      ],
      "description": "Who sent the message"
    },
    "sender_name": {
      "type": "string",
      "description": "Display name of sender (e.g., 'Fooda AI', admin name, customer name)"
    },
    "message": {
      "type": "string",
      "description": "Message content"
    },
    "is_read": {
      "type": "boolean",
      "default": false,
      "description": "Whether message has been read"
    },
    "human_takeover": {
      "type": "boolean",
      "default": false,
      "description": "Whether a human admin has taken over this chat"
    }
  },
  "required": [
    "chat_id",
    "customer_email",
    "sender_type",
    "message"
  ]
}