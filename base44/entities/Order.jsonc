{
  "name": "Order",
  "properties": {
    "accepted_at": {
      "description": "Timestamp when rider accepted the delivery",
      "format": "date-time",
      "type": "string"
    },
    "amount_paid": {
      "description": "Amount paid by customer",
      "type": "number"
    },
    "batch_order_id": {
      "description": "Batch ID linking multiple orders from same customer",
      "type": "string"
    },
    "customer_email": {
      "description": "Customer email",
      "type": "string"
    },
    "customer_name": {
      "description": "Customer name",
      "type": "string"
    },
    "customer_phone": {
      "description": "Customer phone",
      "type": "string"
    },
    "delivery_address": {
      "description": "Delivery address",
      "type": "string"
    },
    "delivery_fee": {
      "description": "Delivery fee",
      "type": "number"
    },
    "delivery_status": {
      "default": "unassigned",
      "description": "Delivery tracking status",
      "enum": [
        "unassigned",
        "assigned",
        "picked_up",
        "on_the_way",
        "delivered"
      ],
      "type": "string"
    },
    "items": {
      "description": "Ordered items",
      "items": {
        "properties": {
          "image_url": {
            "type": "string"
          },
          "item_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "price": {
            "type": "number"
          },
          "quantity": {
            "type": "number"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "notes": {
      "description": "Special instructions",
      "type": "string"
    },
    "payment_method": {
      "description": "Payment method",
      "enum": [
        "card",
        "transfer",
        "ussd",
        "cash"
      ],
      "type": "string"
    },
    "payment_reference": {
      "description": "Payment reference",
      "type": "string"
    },
    "payment_status": {
      "default": "pending",
      "enum": [
        "pending",
        "initiated",
        "paid",
        "failed"
      ],
      "type": "string"
    },
    "promo_code": {
      "description": "Applied promo code string",
      "type": "string"
    },
    "promo_code_id": {
      "description": "ID of the applied promo code",
      "type": "string"
    },
    "refunded": {
      "default": false,
      "description": "Whether a cancelled order has been refunded to the customer",
      "type": "boolean"
    },
    "refunded_at": {
      "description": "When the order was marked as refunded",
      "format": "date-time",
      "type": "string"
    },
    "refunded_by": {
      "description": "Email of the admin who marked the refund",
      "type": "string"
    },
    "restaurant_accepted_at": {
      "description": "When the restaurant accepted the order (starts the live delivery timer)",
      "format": "date-time",
      "type": "string"
    },
    "restaurant_id": {
      "description": "Reference to the restaurant",
      "type": "string"
    },
    "restaurant_name": {
      "description": "Restaurant name for display",
      "type": "string"
    },
    "rider_id": {
      "description": "Assigned rider ID",
      "type": "string"
    },
    "rider_name": {
      "description": "Rider name for display",
      "type": "string"
    },
    "service_fee": {
      "description": "Value-added service fee",
      "type": "number"
    },
    "status": {
      "default": "pending",
      "description": "Order status",
      "enum": [
        "pending",
        "accepted",
        "declined",
        "delivered",
        "cancelled"
      ],
      "type": "string"
    },
    "subtotal": {
      "description": "Subtotal before fees",
      "type": "number"
    },
    "total": {
      "description": "Total amount",
      "type": "number"
    },
    "total_restaurants_in_batch": {
      "description": "Total restaurants in this batch order",
      "type": "number"
    }
  },
  "required": [
    "restaurant_id",
    "customer_email",
    "items",
    "total"
  ],
  "type": "object"
}